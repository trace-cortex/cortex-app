# Cortex backend configuration (single-user, local-first profile).
#
# Copy to .env (scripts/setup_local.sh does this and fills in a random token).
# The backend reads ONLY real environment variables; scripts/start_backend.sh, the launchd
# service and docker-compose export this file for you. NEVER commit .env.
# Full reference: docs/CONFIGURATION.md. Multi-tenant server profile: deploy/cortex.env.example.

# ------------------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------------------
# Bearer token for every REST call. Use a long random value (the setup script generates one;
# the packaged macOS app generates its own per install).
CORTEX_API_KEY=replace-with-a-long-random-token

# Only set to 1 when intentionally running development scripts with the sample
# "dev-local-key" token. The backend refuses to start with that token otherwise.
CORTEX_ALLOW_INSECURE_DEV_TOKEN=0

# ------------------------------------------------------------------------------------------
# Storage (user-owned vault + rebuildable SQLite index)
# ------------------------------------------------------------------------------------------
# To share one memory store with the packaged macOS app, point both at the app's default:
#   CORTEX_VAULT_PATH=~/Library/Application Support/Cortex/Cortex.vault
CORTEX_VAULT_PATH=./backend/data/Cortex.vault
CORTEX_DB_PATH=./backend/data/Cortex.vault/index.sqlite

# Local backup retention (vault/backups/*.zip created by POST /v1/backups or the app).
# Count pruning is on by default; age pruning (days) is opt-in.
CORTEX_BACKUP_RETENTION_COUNT=20
CORTEX_BACKUP_RETENTION_DAYS=0

# ------------------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------------------
# Keep 127.0.0.1 unless a TLS reverse proxy sits in front (see docs/SECURITY.md).
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8766
CORTEX_PUBLIC_BASE_URL=http://127.0.0.1:8766
CORTEX_CORS_ORIGINS=http://127.0.0.1:8766,http://localhost:8766
# The browser extension needs CORS from extension origins; set 0 if you do not use it.
CORTEX_ALLOW_EXTENSION_CORS=1
# uvicorn worker processes (scripts/start_backend.sh --mode fastapi). Keep 1 for a
# single-user SQLite vault; the in-process rate limiter is per worker.
CORTEX_UVICORN_WORKERS=1
# Server flavour used by scripts/start_backend.sh and deploy/launchd: fastapi | standalone
CORTEX_SERVER_MODE=fastapi

# ------------------------------------------------------------------------------------------
# AI-tool (MCP) access
# ------------------------------------------------------------------------------------------
# Optional separate, scoped token for /mcp so MCP configs never carry the app token.
# REST endpoints still require CORTEX_API_KEY; /mcp accepts either.
CORTEX_MCP_API_KEY=
CORTEX_MCP_API_KEY_SCOPES=read,write,export,maintenance
# Which MCP tool list is advertised by default: core (curated) | full | chatgpt
CORTEX_MCP_TOOL_SURFACE=core
# Streamable-HTTP compatibility for /mcp (SSE + Mcp-Session-Id). 0 forces plain JSON.
CORTEX_MCP_STREAMABLE=1

# ------------------------------------------------------------------------------------------
# Retrieval quality (all local; no network)
# ------------------------------------------------------------------------------------------
# hash      = deterministic offline embeddings (default; works with nothing installed)
# model2vec = real on-device semantic embeddings (run scripts/setup_local.sh --with-model)
# openai    = remote OpenAI embeddings (needs OPENAI_API_KEY; data leaves the machine)
CORTEX_EMBEDDING_PROVIDER=hash
CORTEX_MODEL2VEC_PATH=
CORTEX_MODEL2VEC_MODEL=minishlab/potion-base-8M
# Used only by the openai provider. Keep 384 for the hash provider's sqlite-vec schema.
CORTEX_EMBEDDING_MODEL=text-embedding-3-small
CORTEX_EMBEDDING_DIMENSIONS=384
CORTEX_EMBEDDING_STRICT=0
OPENAI_API_KEY=
# Reranker + query planning + temporal decay (same flags the shipped app uses).
CORTEX_RERANK=linear+mmr
CORTEX_QUERY_PLAN=1
CORTEX_TEMPORAL_DECAY=1

# ------------------------------------------------------------------------------------------
# Extraction (optional LLM condenser)
# ------------------------------------------------------------------------------------------
# Unset = deterministic local extractor (capture/search work fully offline).
ANTHROPIC_API_KEY=
CORTEX_EXTRACTION_MODEL=claude-opus-4-5

# ------------------------------------------------------------------------------------------
# Behaviour
# ------------------------------------------------------------------------------------------
# 1 = new captures skip the Review inbox and are retrievable immediately.
CORTEX_AUTO_APPROVE_CAPTURES=0
# Brand used in user-visible backend strings: Cortex | Doppl
CORTEX_APP_BRAND=Cortex
# Background job worker: inline (default; jobs run inside the API process) | external
# (run scripts/run_memory_worker.py separately; used by the multi-tenant profile).
CORTEX_WORKER_MODE=inline
# Operator metrics at GET /v1/metrics (admin token). 0 = off.
CORTEX_OBSERVABILITY_ENABLED=0

# ------------------------------------------------------------------------------------------
# Fair-use limits (0 = disabled; the multi-tenant profile sets non-zero values)
# ------------------------------------------------------------------------------------------
CORTEX_RATE_LIMIT_PER_MINUTE=0
CORTEX_DEFAULT_MEMORY_QUOTA=0
CORTEX_MAX_CONCURRENT_REQUESTS=8
CORTEX_RATE_LIMIT_RPS=20
CORTEX_RATE_LIMIT_BURST=60

# ------------------------------------------------------------------------------------------
# Sync integrity (optional)
# ------------------------------------------------------------------------------------------
# When set, device-bound /v1/sync/changes responses carry an HMAC signature.
CORTEX_SYNC_SIGNING_KEY=

# ------------------------------------------------------------------------------------------
# Multi-tenant / hosted server profile (leave unset for single-user local mode)
# ------------------------------------------------------------------------------------------
# See deploy/cortex.env.example for the full server profile: CORTEX_SHARD_MODE=bucket,
# CORTEX_SHARD_ROOT, CORTEX_REQUIRE_SCOPED_API_TOKENS=1, CORTEX_AUTH_ENABLED=1, CORTEX_KEK_FILE,
# CORTEX_SMTP_*, CORTEX_OIDC_*_CLIENT_ID/SECRET, CORTEX_BILLING_PROVIDER, CORTEX_TURNSTILE_*.
# Docker proxy profile only:
# CORTEX_DOMAIN=cortex.example.internal
